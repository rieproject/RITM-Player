{
  "name": "@ritm/desktop",
  "productName": "RITM Player",
  "version": "1.0.0",
  "description": ".ritm player",
  "homepage": "https://github.com/rieproject/ritm-player",
  "author": "Arie Jakawiguna <arieee.project@gmail.com>",
  "private": true,
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win --x64",
    "dist:dir": "npm run build && electron-builder --win --x64 --dir",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:linux:appimage": "npm run build && electron-builder --linux AppImage",
    "dist:linux:rpm": "npm run build && electron-builder --linux rpm",
    "dist:linux:deb": "npm run build && electron-builder --linux deb",
    "dist:linux:dir": "npm run build && electron-builder --linux --dir",
    "dist:mac": "npm run build && electron-builder --mac",
    "build:web": "tsc -p tsconfig.json && vite build --outDir release-web --emptyOutDir",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:installer": "npm run build && electron-builder --win nsis --x64",
    "typecheck": "tsc -p tsconfig.json",
    "native:win": "sh native/scripts/build-win.sh",
    "native:mac": "sh native/scripts/build-mac.sh",
    "native:test": "sh native/scripts/build-linux.sh && ./native/build/dsp_test"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.1.0",
    "@ritm/player": "*",
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  },
  "build": {
    "appId": "id.rieproject.ritm.player",
    "productName": "RITM Player",
    "copyright": "© rieproject.id | Arie Jakawiguna",
    "electronVersion": "45.2.3",
    "electronDownload": {
      "unsafelyDisableChecksums": true
    },
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "electron/**",
      "build/icon.png",
      "package.json"
    ],
    "asar": true,
    "fileAssociations": [
      {
        "ext": "ritm",
        "name": "RITM Release",
        "description": "Rilisan musik RITM",
        "mimeType": "application/vnd.ritm+zip",
        "icon": "file-icon",
        "role": "Viewer"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "RITM Player",
      "extraResources": [
        {
          "from": "native/bin/win-x64",
          "to": "native",
          "filter": [
            "ritm-audio.exe"
          ]
        },
        {
          "from": "native/bin/win-x64",
          "to": "thumb",
          "filter": [
            "ritm_thumb.dll"
          ]
        }
      ]
    },
    "nsis": {
      "artifactName": "RITM-Player-Setup-${version}.${ext}",
      "include": "build/installer.nsh",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "RITM Player"
    },
    "portable": {
      "artifactName": "RITM-Player-${version}-portable.${ext}"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "extraResources": [
        {
          "from": "native/bin/mac",
          "to": "native",
          "filter": [
            "ritm-audio"
          ]
        }
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "rpm",
        "deb",
        "tar.gz"
      ],
      "artifactName": "RITM-Player-${version}.${ext}",
      "icon": "build/icons",
      "maintainer": "Arie Jakawiguna <arieee.project@gmail.com>",
      "category": "Audio",
      "executableName": "ritm-player",
      "synopsis": "Bit-perfect player for .ritm music releases",
      "description": "High-fidelity audio player for .ritm albums and music files with native ALSA and PipeWire support.",
      "extraResources": [
        {
          "from": "native/bin/linux-x64",
          "to": "native",
          "filter": [
            "ritm-audio"
          ]
        }
      ]
    },
    "appImage": {
      "artifactName": "RITM-Player-${version}.${ext}"
    },
    "rpm": {
      "packageName": "ritm-player",
      "artifactName": "RITM-Player-${version}.${ext}"
    },
    "deb": {
      "packageName": "ritm-player",
      "artifactName": "RITM-Player-${version}.${ext}"
    }
  }
}
